---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" seo={{ robots: 'noindex' }}>
  <div class="wrap prose">
    <p class="label">404</p>
    <h1>We couldn't find that page</h1>
    <p>It may have moved when we rebuilt the site. Try the <a href="/">home page</a>, our <a href="/house-events/">events</a>, or <a href="/contact-us/">contact us</a> and we'll point you in the right direction.</p>
  </div>
</Base>
