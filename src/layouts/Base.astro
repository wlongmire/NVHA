---
// Shared frame for every page: search-engine tags, header, footer.
// Search settings come from the page's own `seo` fields, or from src/data/seo.json (kept from the old Yoast settings)
// when a page passes `seoKey`, and fall back to the site defaults in src/data/site.json.
import '../styles/tokens.css';
import '../styles/global.css';
import site from '../data/site.json';
import seoData from '../data/seo.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  seoKey?: string;
  seo?: { title?: string; description?: string; canonical?: string; ogImage?: string; robots?: string };
  type?: 'website' | 'article';
  published?: string;
  jsonLd?: Record<string, unknown>;
}
const { title, description, image, seoKey, seo = {}, type = 'website', published, jsonLd } = Astro.props;
const saved = (seoKey ? (seoData as Record<string, any>)[seoKey] : undefined) ?? {};
const pick = <T,>(...v: (T | undefined)[]) => v.find((x) => x);

const pageTitle = pick(seo.title, saved.title, title ? `${title} | ${site.shortName}` : undefined) ?? site.name;
const pageDesc = pick(seo.description, saved.description, description) ?? site.description;
const canonical = new URL(pick(seo.canonical, saved.canonical, Astro.url.pathname)!.replace(/^https?:\/\/[^/]+/, ''), Astro.site).href;
const ogImage = new URL(pick(seo.ogImage, saved.ogImage, image, site.defaultImage)!, Astro.site).href;
const robots = pick(seo.robots, saved.robots);
const here = Astro.url.pathname;

const org = {
  '@context': 'https://schema.org',
  '@type': 'NonprofitOrganization',
  name: site.name,
  url: Astro.site!.href,
  logo: new URL(site.defaultImage, Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: '1801 Broadway', addressLocality: 'Camden', addressRegion: 'NJ', postalCode: '08104' },
};
---
<!doctype html>
<html lang="en" data-theme="c">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <meta name="robots" content={robots ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <link rel="canonical" href={canonical} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:image" content={ogImage} />
  {published && <meta property="article:published_time" content={published} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/icon-256.png" type="image/png" />
  <link rel="apple-touch-icon" href="/icon-256.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;700&family=Source+Serif+4:wght@400;600&family=Playfair+Display:ital,wght@0,500;0,700;1,400;1,500&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(here === '/' ? org : jsonLd ?? org)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="site-top">
  <div class="topbar" id="topbar" aria-label="Announcements">
    <div class="wrap topbar-in">
      <button type="button" class="tb-btn" data-dir="-1" aria-label="Previous announcement">‹</button>
      <div class="tb-msgs">
        {site.announcements.map((a, i) => <a class="tb-msg" href={a.href} hidden={i > 0}>{a.text}</a>)}
      </div>
      <button type="button" class="tb-btn" data-dir="1" aria-label="Next announcement">›</button>
      <button type="button" class="tb-btn tb-close" aria-label="Close announcements">×</button>
    </div>
  </div>
  <script is:inline>
    (function () {
      var bar = document.getElementById('topbar'); if (!bar) return;
      try { if (sessionStorage.getItem('nvha-topbar') === 'closed') { bar.hidden = true; return; } } catch (e) {}
      var msgs = bar.querySelectorAll('.tb-msg'), i = 0;
      function show(n) { i = (n + msgs.length) % msgs.length; msgs.forEach(function (m, k) { m.hidden = k !== i; }); }
      bar.querySelectorAll('[data-dir]').forEach(function (b) { b.addEventListener('click', function () { show(i + +b.dataset.dir); }); });
      if (msgs.length < 2) bar.querySelectorAll('[data-dir]').forEach(function (b) { b.hidden = true; });
      bar.querySelector('.tb-close').addEventListener('click', function () { bar.hidden = true; try { sessionStorage.setItem('nvha-topbar', 'closed'); } catch (e) {} });
    })();
  </script>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href="/" aria-label={`${site.shortName}, home`}>
        <img class="brand-logo" src="/brand/nvha-horizontal.png" alt="The Nick Virgilio Haiku Association" width="1778" height="869" />
        <span class="brand-tag">Home of the Virgilio <br />Writers House</span>
      </a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menu" />
      <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span></label>
      <nav class="site-nav" aria-label="Main">
        <div class="nav-links">
          {site.nav.map((n) => {
            const cur = n.href === '/' ? (here === '/' ? 'page' : undefined) : here.startsWith(n.href) ? 'page' : undefined;
            return n.children ? (
              <div class="nav-item">
                <a href={n.href} aria-current={cur} aria-haspopup="true">{n.label}<svg class="caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
                <ul class="sub">
                  {n.children.map((c) => c.divider ? <li class="sep" role="separator"></li> : <li><a href={c.href}>{c.label}</a></li>)}
                </ul>
              </div>
            ) : <a href={n.href} aria-current={cur}>{n.label}</a>;
          })}
        </div>
        <div class="nav-actions">
          <a class="btn line" href="/newsletter/">Newsletter</a>
          <a class="btn" href={site.donateHref}>Donate</a>
        </div>
      </nav>
    </div>
  </header>
  </div>

  <main id="main"><slot /></main>
  <button type="button" class="to-top" id="to-top" aria-label="Back to top" hidden>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
  </button>
  <script is:inline>
    (function () {
      var b = document.getElementById('to-top'); if (!b) return;
      var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      function update() { var on = scrollY > innerHeight * 0.8; if (on && b.hidden) b.hidden = false; b.classList.toggle('show', on); }
      addEventListener('scroll', update, { passive: true }); update();
      b.addEventListener('click', function () { scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' }); });
    })();
  </script>

  <footer class="site-footer">
    <div class="wrap foot">
      <div>
        <img class="foot-logo" src="/brand/dark-nvha.png" alt="The Nick Virgilio Haiku Association" width="1466" height="722" />
        <p>Since 2002, a local &amp; global space for poets — inspiring writers, strengthening education and promoting community.</p>
      </div>
      {site.footerGroups.map((g) => (
        <div>
          <h2 class="label">{g.title}</h2>
          <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
      ))}
      <div>
        <h2 class="label">Visit</h2>
        <p>Writers House, Waterfront South<br />{site.address}</p>
        <p><a href="https://www.njhistory.org/">A NJ Literary Landmark</a></p>
      </div>
    </div>
    <div class="wrap legal">© {new Date().getFullYear()} Nick Virgilio Haiku Association &amp; Writers House. All rights reserved.</div>
  </footer>
</body>
</html>
