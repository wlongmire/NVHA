---
// A picture with a fixed shape. When `src` is empty it shows a labelled placeholder, so layouts hold their shape before the real photo exists.
const { src = '', alt = '', ratio = '4 / 3', label = 'Photo coming soon', class: cls = '', loading = 'lazy', position = 'center' } = Astro.props;
---
{src
  ? <img class:list={['photo', cls]} src={src} alt={alt} style={`aspect-ratio:${ratio};object-position:${position}`} loading={loading} />
  : <div class:list={['photo', 'placeholder', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={label}><span>{label}</span></div>}
<style is:global>
  .photo { width: 100%; object-fit: cover; border-radius: var(--radius); background: #0001; }
  .placeholder { display: grid; place-items: center; text-align: center; padding: 1rem; color: var(--muted); font-family: var(--font-label); font-size: .75rem; text-transform: uppercase; letter-spacing: .08em;
    background: repeating-linear-gradient(135deg, #0000000d 0 12px, #00000005 12px 24px); border: 1px dashed #0004; }
</style>
