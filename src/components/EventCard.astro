---
import Photo from './Photo.astro';
import { fmtDay, fmtTime, hasTime } from '../lib/dates';
const { event } = Astro.props;
const d = event.data;
---
<article class="event">
  <Photo src={d.image} alt="" ratio="1 / 1" label="Event photo" />
  <div>
    <p class="label">{fmtDay(d.start)}{hasTime(d.start) && ` · ${fmtTime(d.start)}`}</p>
    <h3><a href={`/event/${event.id}/`}>{d.title}</a></h3>
    {d.venue && <p class="where">{d.venue}</p>}
    {d.link && <a class="btn rose" href={d.link} rel="noopener">RSVP</a>}
  </div>
</article>
<style>
  .event { display: grid; grid-template-columns: 6rem 1fr; gap: 1.25rem; align-items: start; padding-block: 1.5rem; border-bottom: 1px solid #0002; }
  .event h3 { font-size: 1.25rem; margin-bottom: .25rem; } .event h3 a { text-decoration: none; }
  .where { color: var(--muted); margin: 0 0 .75rem; }
</style>
