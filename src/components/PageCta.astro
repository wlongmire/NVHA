---
// The closing band at the bottom of content pages.
---
<section class="cta" aria-label="Get started">
  <div class="wrap cta-in">
    <div>
      <p class="kick">Sharpen your craft</p>
      <h2>Write your first haiku with us in Camden.</h2>
      <p class="sub">Free workshops for poets of every level — learn to listen, distill, and let the weight of silence.</p>
    </div>
    <a class="btn" href="/online-workshops/">See workshops</a>
  </div>
</section>
<style>
  .cta { background: var(--brick); color: #fff; border-block: 4px solid var(--ink); padding-block: clamp(2rem, 5vw, 3.25rem); margin-top: clamp(2rem, 5vw, 4rem); }
  .cta-in { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem 2rem; }
  .kick { margin: 0 0 .4rem; font-family: var(--font-label); font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; }
  .cta h2 { margin: 0 0 .5rem; font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; }
  .sub { margin: 0; max-width: 36rem; font-size: .9rem; }
  .cta .btn { --ink-sh: var(--ink); border-color: var(--ink); }
</style>
