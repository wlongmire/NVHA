---
// A grid of people cards (board, staff). Each person: name, role (optional), bio, photo (optional path under /uploads/),
// links (optional list of { type, href }; type is instagram, facebook, x, linkedin, youtube, bluesky, website or email),
// and more (optional longer text, shown in a popup behind a "More" button; blank lines start new paragraphs).
// Without a photo the card shows initials on a palette color. *Asterisks* in a bio set italics.
const { people = [], fallbackRole = '' } = Astro.props;
const tones = ['periwinkle', 'mustard', 'brick', 'cream'];
const initials = (n: string) => n.replace(/\b(Dr|Sr|Jr)\.?/g, '').split(/\s+/).filter(Boolean).filter((w) => /^[A-Za-z]/.test(w) && !/^[A-Z]\.$/.test(w)).slice(0, 2).map((w) => w[0].toUpperCase()).join('');
const labels: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', x: 'X', linkedin: 'LinkedIn', youtube: 'YouTube', bluesky: 'Bluesky', website: 'Website', email: 'Email' };
// simple outline icons, all drawn on a 24x24 grid
const icons: Record<string, string> = {
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />',
  linkedin: '<rect x="3.5" y="3.5" width="17" height="17" rx="2.5" /><path d="M8 10.5v6M8 7.6v.1M11.5 16.5v-6M11.5 13c0-1.6 1.1-2.5 2.4-2.5 1.4 0 2.1.9 2.1 2.5v3.5" />',
  facebook: '<circle cx="12" cy="12" r="8.5" /><path d="M13.5 20.5v-8h2.3M10.2 12.5h5.6M13.5 12.5V10c0-1.2.6-1.8 1.8-1.8h.6" />',
  x: '<path d="M5 5l14 14M19 5L5 19" />',
  youtube: '<rect x="3" y="6" width="18" height="12" rx="3.5" /><path d="M10.5 9.5v5l4.2-2.5z" fill="currentColor" />',
  bluesky: '<path d="M12 11.5C10.6 8.8 8 6 5.5 5.2 4.6 5 4 5.600 4.200 7c.3 2.700 1 5 4.300 5.200-2.500.4-3.300 2.200-1.600 3.700 2.200 1.800 3.800-.6 5.100-2.600 1.300 2 2.900 4.400 5.100 2.600 1.700-1.500.9-3.300-1.600-3.700 3.300-.2 4-2.500 4.300-5.200.2-1.400-.4-2-1.300-1.800C16 6 13.400 8.800 12 11.500z" />',
  website: '<circle cx="12" cy="12" r="8.5" /><path d="M3.500 12h17M12 3.500c2.500 2.400 3.500 5.300 3.500 8.500s-1 6.100-3.500 8.500c-2.500-2.400-3.500-5.300-3.500-8.500s1-6.100 3.500-8.500z" />',
  email: '<rect x="3" y="5.500" width="18" height="13" rx="2" /><path d="M3.500 7.500l8.500 6 8.500-6" />',
};
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\*(.+?)\*/g, '<em>$1</em>');
---
<ul class="people">
  {people.map((p, i) => (
    <li class="person">
      <div class={`pic ${tones[i % tones.length]}`}>
        {p.photo ? <img src={p.photo} alt={p.name} loading="lazy" /> : <span aria-hidden="true">{initials(p.name)}</span>}
      </div>
      <div class="info">
        <p class="role">{p.role || fallbackRole}</p>
        <h3>{p.name}</h3>
        <p class="bio" set:html={esc(p.bio)} />
        {(p.links?.length || p.more) && (
          <div class="extras">
            {p.links?.length ? (
              <div class="socs">
                {p.links.map((l) => (
                  <a class="soc" href={l.type === 'email' && !l.href.startsWith('mailto:') ? `mailto:${l.href}` : l.href} target={l.type === 'email' ? undefined : '_blank'} rel="noopener" aria-label={`${p.name} on ${labels[l.type] ?? l.type}`} title={labels[l.type] ?? l.type}>
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[l.type] ?? icons.website} />
                  </a>
                ))}
              </div>
            ) : null}
            {p.more && <button type="button" class="more" data-dialog={`person-${i}`}>More</button>}
          </div>
        )}
      </div>
      {p.more && (
        <dialog class="pop" id={`person-${i}`} aria-label={p.name}>
          <button type="button" class="x" aria-label="Close">×</button>
          <p class="role">{p.role || fallbackRole}</p>
          <h3>{p.name}</h3>
          {p.more.split(/\n\s*\n/).map((para) => <p set:html={esc(para)} />)}
        </dialog>
      )}
    </li>
  ))}
</ul>
<script>
  document.querySelectorAll<HTMLButtonElement>('.people .more').forEach((b) => {
    const d = document.getElementById(b.dataset.dialog!) as HTMLDialogElement | null;
    if (!d) return;
    b.addEventListener('click', () => d.showModal());
    d.querySelector('.x')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });   // a click on the dim backdrop closes it
  });
</script>
<style>
  .people { list-style: none; padding: 0 !important; margin: 1.25rem 0 0; display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .person { margin: 0 !important; display: flex; flex-direction: column; background: var(--paper); border: 3px solid var(--ink); box-shadow: 5px 5px 0 var(--ink); }
  .pic { aspect-ratio: 4 / 3; display: grid; place-items: center; border-bottom: 3px solid var(--ink); overflow: hidden; }
  .pic.periwinkle { background: var(--periwinkle); } .pic.mustard { background: var(--mustard); } .pic.brick { background: var(--brick); color: #fff; } .pic.cream { background: var(--cream); }
  .pic span { font-family: var(--font-display); font-weight: 800; font-size: 3rem; letter-spacing: .02em; }
  .pic img { width: 100%; height: 100%; object-fit: cover; border: 0 !important; box-shadow: none !important; margin: 0 !important; }
  .info { padding: 1rem 1.1rem 1.25rem; display: flex; flex-direction: column; flex: 1; }
  .role { font-family: var(--font-label); font-size: .72rem !important; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 .35rem; min-height: 2.2em; display: flex; align-items: flex-end; }
  h3 { margin: 0 0 .5rem; font-size: 1.15rem; line-height: 1.15; }
  .bio { margin: 0; font-size: .9rem !important; line-height: 1.5; }
  .extras { display: flex; flex-direction: column; align-items: center; gap: .75rem; margin-top: auto; padding-top: 1rem; }
  .socs { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; }
  .soc { display: grid; place-items: center; width: 2rem; height: 2rem; color: var(--ink); transition: transform .2s ease; }
  .soc:hover, .soc:focus-visible { transform: translateY(-2px); }
  .more { font: inherit; font-size: .8rem; font-weight: 700; padding: .25rem .8rem; background: var(--mustard); color: var(--ink); border: 2px solid var(--ink); box-shadow: 2px 2px 0 var(--ink); cursor: pointer; }
  .more:hover, .more:focus-visible { transform: translate(1px, 1px); box-shadow: 1px 1px 0 var(--ink); }
  .pop { width: min(34rem, calc(100vw - 2rem)); max-height: calc(100vh - 3rem); overflow-y: auto; padding: 1.5rem 1.5rem 1.25rem; background: var(--paper); color: var(--ink); border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  .pop::backdrop { background: #1f1d1d99; }
  .pop h3 { font-size: 1.5rem; margin-bottom: .75rem; }
  .pop p:not(.role) { font-size: .95rem; line-height: 1.6; }
  .pop .role { min-height: 0; margin-bottom: .25rem; }
  .x { position: absolute; top: .4rem; right: .6rem; background: none; border: 0; font-size: 1.75rem; line-height: 1; cursor: pointer; color: var(--ink); }
</style>
