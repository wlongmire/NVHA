---
import EventCard from '../EventCard.astro';
import Photo from '../Photo.astro';
import site from '../../data/site.json';
import home from '../../data/home.json';
import { loadHome } from '../../lib/homeData';
import { fmtDay } from '../../lib/dates';

const { hasNext, upcoming, products, haikuPosts } = await loadHome();
// "Visit the House" points at what's on next, worked out when the site is built (every save in /edit rebuilds it)
const money = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
// a short blurb for each item: the start of its description, with markdown marks removed
const blurb = (md = '') => {
  const t = md.replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/[#*_>`]/g, '').replace(/\s+/g, ' ').trim();
  return t.length > 200 ? t.slice(0, 197).replace(/\s+\S*$/, '') + '…' : t;
};
const nextEvent = hasNext ? upcoming[0] : undefined;
const describe = (a: { href: string; blurb: string }) =>
  a.href === '#house' && nextEvent ? `Next up: ${nextEvent.data.title}, ${fmtDay(nextEvent.data.start)}.` : a.blurb;
const { hero, featured, house, educators, donate } = home;
// A hero button that links to a YouTube video or an audio file opens it in a popup on the page instead of leaving the site.
const youtubeId = (href: string) => href.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]{11})/)?.[1];
const isAudio = (href: string) => /\.(mp3|m4a|wav|ogg)$/i.test(href);
---
  <dialog class="media-pop" aria-labelledby="media-title">
    <div class="media-head">
      <h2 id="media-title" class="media-title"></h2>
      <button type="button" class="media-close" aria-label="Close">×</button>
    </div>
    <div class="media-frame"></div>
    <p class="media-caption" hidden></p>
  </dialog>
  <script>
    const pop = document.querySelector<HTMLDialogElement>('.media-pop');
    const frame = pop?.querySelector<HTMLElement>('.media-frame');
    if (pop && frame && typeof pop.showModal === 'function') {
      document.querySelectorAll<HTMLAnchorElement>('a[data-media]').forEach((a) => a.addEventListener('click', (e) => {
        e.preventDefault();
        const { media, video, title, caption, cover } = a.dataset;
        if (media === 'video') {
          const f = document.createElement('iframe');
          f.src = `https://www.youtube-nocookie.com/embed/${video}?autoplay=1&rel=0`;
          f.title = title ?? 'Video';
          f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          f.allowFullscreen = true;
          frame.className = 'media-frame is-video';
          frame.replaceChildren(f);
        } else {
          // a small player in the site's style: play/pause, a seek bar and the time
          const audio = new Audio(a.href);
          audio.preload = 'auto';
          const player = document.createElement('div');
          player.className = 'player';
          player.innerHTML = `<button type="button" class="play" aria-label="Pause"><span aria-hidden="true"></span></button>
            <div class="track"><input type="range" min="0" max="1000" value="0" aria-label="Position in recording" />
            <div class="times"><span class="now">0:00</span><span class="total">–:––</span></div></div>`;
          const play = player.querySelector<HTMLButtonElement>('.play')!;
          const seek = player.querySelector<HTMLInputElement>('input')!;
          const fmt = (t: number) => (isFinite(t) ? `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}` : '–:––');
          const sync = () => {
            play.classList.toggle('is-playing', !audio.paused);
            play.setAttribute('aria-label', audio.paused ? 'Play' : 'Pause');
          };
          play.addEventListener('click', () => (audio.paused ? audio.play() : audio.pause()));
          audio.addEventListener('play', sync); audio.addEventListener('pause', sync); audio.addEventListener('ended', sync);
          audio.addEventListener('loadedmetadata', () => { player.querySelector('.total')!.textContent = fmt(audio.duration); });
          audio.addEventListener('timeupdate', () => {
            player.querySelector('.now')!.textContent = fmt(audio.currentTime);
            if (audio.duration) { seek.value = String(Math.round((audio.currentTime / audio.duration) * 1000)); seek.style.setProperty('--p', `${seek.value / 10}%`); }
          });
          seek.addEventListener('input', () => { if (audio.duration) audio.currentTime = (Number(seek.value) / 1000) * audio.duration; });
          const parts: Node[] = [];
          if (cover) { const img = document.createElement('img'); img.src = cover; img.alt = ''; parts.push(img); }
          parts.push(player, audio);
          frame.className = 'media-frame is-audio';
          frame.replaceChildren(...parts);
          audio.play().catch(sync);
          sync();
        }
        pop.querySelector('.media-title')!.textContent = title ?? a.textContent ?? '';
        const cap = pop.querySelector<HTMLElement>('.media-caption')!;
        cap.textContent = caption ?? '';
        cap.hidden = !caption;
        pop.showModal();
      }));
      // closing stops playback; clicking the dark area outside also closes
      const stop = () => { frame.querySelector('audio')?.pause(); frame.replaceChildren(); };
      const shut = () => { stop(); pop.close(); };
      pop.addEventListener('cancel', stop);   // Escape key
      pop.addEventListener('close', stop);
      pop.querySelector('.media-close')?.addEventListener('click', shut);
      pop.addEventListener('click', (e) => { if (e.target === pop) shut(); });
    }
  </script>
  <script>
    // article cards: the arrow buttons, and the left and right arrow keys, move along the row
    document.querySelectorAll<HTMLElement>('.reads').forEach((box) => {
      const list = box.querySelector<HTMLElement>('ul');
      if (!list) return;
      const move = (dir: number) => {
        const card = list.querySelector<HTMLElement>('li');
        if (card) list.scrollBy({ left: dir * (card.offsetWidth + 20), behavior: 'smooth' });
      };
      box.querySelectorAll<HTMLElement>('[data-reads]').forEach((b) => b.addEventListener('click', () => move(Number(b.dataset.reads))));
      list.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); move(e.key === 'ArrowRight' ? 1 : -1); }
      });
    });
  </script>
  <script>
    // the amount chips pass the chosen gift on to the donation page
    document.querySelectorAll<HTMLElement>('[data-give]').forEach((box) => {
      const btn = box.querySelector<HTMLAnchorElement>('[data-give-btn]');
      const base = box.dataset.href || '/donate-now/';
      const update = () => {
        const v = box.querySelector<HTMLInputElement>('input:checked')?.value;
        if (btn) btn.href = v ? `${base}?amount=${v}` : base;
      };
      box.addEventListener('change', update);
      update();
    });
  </script>
  <script>
    // event photos fade from one to the next every five seconds (paused for people who prefer reduced motion)
    document.querySelectorAll<HTMLElement>('[data-slides]').forEach((box) => {
      const imgs = [...box.querySelectorAll('img')];
      let i = 0;
      if (imgs.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      setInterval(() => { imgs[i].classList.remove('on'); i = (i + 1) % imgs.length; imgs[i].classList.add('on'); }, 5000);
    });
  </script>
  <script>
    document.querySelectorAll<HTMLElement>('[data-shop]').forEach((b) =>
      b.addEventListener('click', () => {
        const shop = b.closest('.panel')?.querySelector<HTMLElement>('.shop');
        const item = shop?.querySelector<HTMLElement>('.item');
        if (shop && item) shop.scrollBy({ left: Number(b.dataset.shop) * (item.offsetWidth + 20), behavior: 'smooth' });
      }),
    );
  </script>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>{hero.headline.split(/(Camden|world|write|reflect|gather)/).map((part) => /^(Camden|world)$/.test(part) ? <mark>{part}</mark> : /^(write|reflect|gather)$/.test(part) ? <span class="ul">{part}</span> : part)}</h1>
        <p class="lede">{hero.text}</p>
        <p class="btns">{hero.buttons.map((b) => {
          const vid = youtubeId(b.href);
          const media = vid ? 'video' : isAudio(b.href) ? 'audio' : undefined;
          const x = b as { popupTitle?: string; caption?: string; cover?: string };
          return <a class={`btn ${b.style === 'rose' ? 'rose' : ''}`} href={b.href} data-media={media} data-video={vid}
            data-title={media ? x.popupTitle ?? b.label : undefined} data-caption={media ? x.caption : undefined} data-cover={media === 'audio' ? x.cover : undefined}
            aria-haspopup={media ? 'dialog' : undefined}>{b.label}</a>;
        })}</p>
      </div>
      <div class="hero-art">
        <Photo src={hero.image} alt={hero.imageAlt} ratio="1 / 1" position={hero.imagePosition} label="Hero image" loading="eager" />
      </div>
    </div>
  </section>
  {/* outside the hero on purpose: it is fixed to the screen, and inside the hero it would be stacked under the panels that follow */}
  <nav class="wrap actions" aria-label="Jump to a section">
    {home.actions.map((a, i) => (
      <div class="action-slot">
        {/* invisible copy of the label that holds the slot's size, so the box can grow without moving anything */}
        <span class="action-label sizer" aria-hidden="true"><span>{a.href === '#house' && nextEvent && <span class="live-dot" />}{a.link}</span><span class="arrow">↓</span></span>
        <div class="action-box">
          <div class="action-more" id={`more-${i}`}>
            <div><p>{describe(a)}</p></div>
          </div>
          <a class="action-label action-link" href={a.href} aria-describedby={`more-${i}`}><span>{a.href === '#house' && nextEvent && <span class="live-dot" aria-hidden="true" />}{a.link}</span><span class="arrow" aria-hidden="true">↓</span></a>
        </div>
      </div>
    ))}
  </nav>


  <script>
    // the audience buttons stay on screen as you scroll; they step aside when the footer comes into view,
    // and the round back-to-top button rides above them while they are showing
    const bar = document.querySelector<HTMLElement>('.actions');
    const foot = document.querySelector('.site-footer');
    if (bar && foot) {
      const lift = () => document.documentElement.style.setProperty('--lift', getComputedStyle(bar).position === 'fixed' && !bar.classList.contains('away') ? `${bar.offsetHeight + 12}px` : '0px');
      if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { bar.classList.toggle('away', e.isIntersecting); lift(); }).observe(foot);
      addEventListener('resize', lift); lift();
      const fade = () => bar.classList.toggle('floating', scrollY > innerHeight * 0.15);
      addEventListener('scroll', fade, { passive: true }); fade();
      // each arrow points toward its panel: down while the panel is still ahead, up once you have scrolled past its top
      const slots = [...bar.querySelectorAll<HTMLElement>('.action-slot')].map((slot) => ({ slot, target: document.querySelector(slot.querySelector('a')!.getAttribute('href')!) }));
      const aim = () => slots.forEach(({ slot, target }) => { if (target) slot.dataset.dir = target.getBoundingClientRect().top < 100 ? 'up' : 'down'; });
      addEventListener('scroll', aim, { passive: true }); addEventListener('resize', aim); aim();
    }
  </script>

  <section class="featured" aria-label="Featured" style={`--bg: url('${house.nickImage}')`}>
    <div class="wrap feat-grid">
      <div class="feat-copy">
        {featured.kind && <p class="feat-kind">{featured.kind}</p>}
        <h2>{featured.title}</h2>
        {featured.text.split(/\n\s*\n/).map((para) => <p>{para}</p>)}
        {featured.href && <a class="btn rose" href={featured.href}>{featured.link || 'Learn more'}</a>}
      </div>
      {featured.image && <img class="feat-img" src={featured.image} alt={featured.imageAlt} loading="lazy" />}
    </div>
  </section>

  <section class="band cream" id="house">
    <div class="wrap">
      <header class="band-head"><div>{home.kickers.house && <p class="kicker">{home.kickers.house}</p>}<h2>At the Writers House</h2></div></header>
      <div class="house">
        <figure>
          <Photo src={house.houseImage} alt="" ratio="1 / 1" />
          <figcaption><strong>{house.houseCaption}</strong><br />{site.address}</figcaption>
          <a class="btn rose" href="/writers-house/">About the House</a>
        </figure>
        <figure>
          <Photo src={house.nickImage} alt="Nick Virgilio at his typewriter" ratio="1 / 1" />
          <figcaption>{house.nickCaption}</figcaption>
          <a class="btn rose" href="/nick-virgilio-poet/">About Nick</a>
        </figure>
        <div class="events">
          <h3>{hasNext ? 'Upcoming events' : 'Recent events'}</h3>
          {!hasNext && <p>Nothing new is scheduled yet. Here is what we've been up to.</p>}
          {upcoming.slice(0, 2).map((e) => <EventCard event={e} />)}
          <a class="btn rose" href="/house-events/">More events</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band yellow" id="poets">
    <div class="wrap">
      <header class="band-head"><div>{home.kickers.poets && <p class="kicker">{home.kickers.poets}</p>}<h2>Poets &amp; Haikuists</h2></div></header>
      <div class="three">
        {home.programs.map((p) => (
          <article class="card">
            <Photo src={p.image} alt="" ratio="1 / 1" />
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            {p.note && <p class="note">{p.note}</p>}
            <a class="btn rose" href={p.href}>{p.link}</a>
          </article>
        ))}
      </div>
      {haikuPosts.length > 0 && (
        <div class="reads">
          <div class="reads-head">
            <h3>Keep reading about haiku</h3>
          </div>
          <ul aria-label="Haiku articles; use the left and right arrow keys to browse">{haikuPosts.map((a) => (
            <li><a href={`/${a.id}/`}><span class="reads-tag">Article</span><strong>{a.data.title}</strong><span class="reads-go">Read &rarr;</span></a></li>
          ))}</ul>
          <span class="reads-nav">
              <button class="car-btn" type="button" data-reads="-1" aria-label="Previous articles">&#8592;</button>
              <button class="car-btn" type="button" data-reads="1" aria-label="Next articles">&#8594;</button>
              <a class="btn rose" href="/blogs/">All articles</a>
            </span>
        </div>
      )}
    </div>
  </section>

  <section class="band rose" id="educators">
    <div class="wrap">
      <header class="band-head"><div>{home.kickers.educators && <p class="kicker">{home.kickers.educators}</p>}<h2>For Educators</h2></div></header>
      <div class="split">
        <Photo src={educators.image} alt={educators.imageAlt} ratio="1 / 1" />
        <div>
          <h3 class="big">{educators.title}</h3>
          <p class="sub">{educators.subtitle}</p>
          <p>{educators.text}</p>
          <p class="stats">{educators.stats.map((s) => <span><b>{s.n}</b>{s.label}</span>)}</p>
          <p class="btns">
            <a class="btn" href={educators.href}>{educators.link}</a>
            <a class="btn paper" href={educators.prospectusHref} target="_blank" rel="noopener">{educators.prospectusLink}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band blue" id="support">
    <div class="wrap">
      <header class="band-head"><div>{home.kickers.support && <p class="kicker">{home.kickers.support}</p>}<h2>Support Our Work</h2></div></header>
      <div class="support">
        <div class="panel dark">
          <h3>Books and merchandise</h3>
          <div class="shop" tabindex="0" aria-label="Books and merchandise, scroll sideways for more">{products.map((p) => (
            <article class="item">
              <a class="item-link" href="/store/"><Photo src={p.data.image} alt="" ratio="1 / 1" /><strong>{p.data.title}</strong><em>{money(p.data.price)}</em><span>{blurb(p.body)}</span></a>
              {p.data.inStock ? <a class="btn rose buy" href={p.data.buyLink || '/store/'}>Buy</a> : <span class="sold">Sold out</span>}
            </article>
          ))}</div>
          <div class="shop-foot">
            <a class="btn rose" href="/store/">See more</a>
            <span class="shop-arrows"><button class="car-btn" type="button" data-shop="-1" aria-label="Previous items">&#8592;</button><button class="car-btn" type="button" data-shop="1" aria-label="Next items">&#8594;</button></span>
          </div>
        </div>
        <div class="panel dark rent">
          <div class="slides" data-slides role="group" aria-label="Photos from events at the Writers House">
            <img class="on" src="/uploads/2026/11/house-audience.jpg" alt="A full room of neighbors listening to a reading at the Writers House" loading="lazy" />
            <img src="/uploads/2026/11/house-reading.jpg" alt="A poet reading at the podium in the Writers House front room" loading="lazy" />
          </div>
          <h3>{home.support.rentTitle}</h3>
          <p>The Writers House is available for readings, workshops and community events, and our poets are available to hire. Rentals and bookings help fund our free programs.</p>
          <p class="btns"><a class="btn rose" href={home.support.rentHref}>{home.support.rentLink}</a></p>
        </div>
      </div>
      <div class="panel dark give" data-give data-href={donate.href}>
        <div class="give-copy">
          <h3>Give today</h3>
          <p>Your gift keeps our workshops, readings and youth programs free for everyone in Camden.</p>
        </div>
        <form class="give-form" onsubmit="return false">
          <fieldset>
            <legend class="sr">Choose an amount</legend>
            {donate.amounts.map((a, i) => (
              <label class="chip"><input type="radio" name="amt" value={a} checked={i === 0} /><span>${a}</span></label>
            ))}
            <label class="chip"><input type="radio" name="amt" value="" /><span>Other</span></label>
          </fieldset>
          <a class="btn rose" data-give-btn href={donate.href}>Donate</a>
        </form>
      </div>
    </div>
  </section>

  <section class="supporters" id="supporters" aria-label="Our supporters">
    <div class="wrap">
      <header class="band-head">{home.kickers.supporters ? <div><p class="kicker">{home.kickers.supporters}</p><h2>Our Supporters</h2></div> : <h2>Our Supporters</h2>}</header>
    </div>
    <div class="carousel" data-carousel>
      <button class="car-btn" type="button" data-dir="-1" aria-label="Previous supporter">&#8592;</button>
      <div class="car-view">
        <ul class="car-track">
          {home.supporters.map((s) => <li><img src={s.logo} alt={s.name} loading="lazy" /><span>{s.caption ?? s.name}</span></li>)}
        </ul>
      </div>
      <button class="car-btn" type="button" data-dir="1" aria-label="Next supporter">&#8594;</button>
    </div>
  </section>
  <script>
    // supporters: steps one logo at a time (on its own every few seconds, or with the arrows) and loops back round to the first
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((car) => {
      const track = car.querySelector<HTMLElement>('.car-track')!;
      const originals = Array.from(track.children) as HTMLElement[];
      const n = originals.length;
      originals.forEach((li) => { const c = li.cloneNode(true) as HTMLElement; c.setAttribute('aria-hidden', 'true'); c.querySelector('img')?.setAttribute('alt', ''); track.appendChild(c); });
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let idx = 0, busy = false, paused = false;
      const width = () => originals[0].offsetWidth;
      const place = (animate: boolean) => {
        track.style.transition = animate ? 'transform .6s ease' : 'none';
        track.style.transform = `translate3d(${-idx * width()}px,0,0)`;
        if (!animate) void track.offsetWidth;
      };
      const step = (dir: number) => {
        if (busy) return;
        if (dir < 0 && idx === 0) { idx = n; place(false); }
        busy = true;
        idx += dir;
        place(!still);
        // transitionend can be skipped (hidden tab, reduced motion), so a timer finishes the step too
        setTimeout(done, still ? 0 : 650);
      };
      const done = () => { if (!busy) return; if (idx >= n) { idx -= n; place(false); } busy = false; };
      car.querySelectorAll<HTMLElement>('.car-btn').forEach((b) => b.addEventListener('click', () => step(Number(b.dataset.dir))));
      car.addEventListener('mouseenter', () => { paused = true; });
      car.addEventListener('mouseleave', () => { paused = false; });
      car.addEventListener('focusin', () => { paused = true; });
      car.addEventListener('focusout', () => { paused = false; });
      addEventListener('resize', () => place(false));
      if (!still) setInterval(() => { if (!paused && !document.hidden) step(1); }, 3500);
    });
  </script>

<style>
  .media-pop { width: min(60rem, 92vw); max-height: 92vh; padding: clamp(1.25rem, 3vw, 2rem); border: 2px solid var(--ink); border-radius: var(--radius); background: var(--paper); color: var(--ink); box-shadow: 8px 8px 0 var(--ink); }
  .media-pop::backdrop { background: #1f1d1dcc; }
  .media-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
  .media-title { font-style: italic; font-weight: 400; font-size: clamp(1.5rem, 3vw, 2.25rem); line-height: 1.1; margin: .25rem 0 0; }
  .media-frame.is-video { aspect-ratio: 16 / 9; background: #000; border-radius: var(--radius); overflow: hidden; }
  .media-frame.is-audio { display: flex; align-items: center; gap: 1.5rem; padding: 1.25rem; background: #9a9df726; border-radius: var(--radius); }
  .media-frame.is-audio :global(img) { width: 9rem; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); flex: none; filter: grayscale(1); }
  .media-frame.is-audio :global(audio) { display: none; }
  .media-frame :global(.player) { flex: 1; min-width: 0; display: flex; align-items: center; gap: 1.25rem; }
  .media-frame :global(.play) { flex: none; width: 3.75rem; height: 3.75rem; border: 2px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); border-radius: 999px; background: var(--accent); cursor: pointer; display: grid; place-items: center; }
  .media-frame :global(.play:hover), .media-frame :global(.play:focus-visible) { filter: brightness(1.08); outline-offset: 3px; }
  /* triangle for play; two bars for pause */
  .media-frame :global(.play span) { width: 0; height: 0; margin-left: 4px; border-style: solid; border-width: 10px 0 10px 16px; border-color: transparent transparent transparent #fff; }
  .media-frame :global(.play.is-playing span) { width: 14px; height: 18px; margin: 0; border: 0; border-left: 5px solid #fff; border-right: 5px solid #fff; }
  .media-frame :global(.track) { flex: 1; min-width: 0; }
  .media-frame :global(.track input) { width: 100%; height: 6px; margin: 0; appearance: none; border-radius: 999px; cursor: pointer; background: linear-gradient(90deg, var(--ink) var(--p, 0%), #1f1d1d26 var(--p, 0%)); }
  .media-frame :global(.track input::-webkit-slider-thumb) { appearance: none; width: 16px; height: 16px; border-radius: 999px; background: var(--ink); border: 3px solid var(--paper); box-shadow: 0 0 0 1px #1f1d1d40; }
  .media-frame :global(.track input::-moz-range-thumb) { width: 12px; height: 12px; border-radius: 999px; background: var(--ink); border: 3px solid var(--paper); }
  .media-frame :global(.times) { display: flex; justify-content: space-between; margin-top: .5rem; font-family: var(--font-label); font-size: .8rem; color: var(--muted); }
  @media (max-width: 40rem) { .media-frame.is-audio { flex-direction: column; align-items: stretch; } .media-frame.is-audio :global(img) { width: 100%; aspect-ratio: 16 / 9; } }
  .media-frame :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .media-caption { margin: 1.1rem 0 0; color: var(--muted); max-width: 46rem; }
  .media-close { flex: none; width: 2.5rem; height: 2.5rem; border: 2px solid var(--ink); box-shadow: 2px 2px 0 var(--ink); border-radius: 999px; background: var(--paper); color: var(--ink); font-size: 1.5rem; line-height: 1; cursor: pointer; }
  .media-close:hover, .media-close:focus-visible { background: var(--periwinkle); }
  /* hero */
